ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vercel Postgres (se obtiene automáticamente al correr: vercel env pull .env.local)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Google OAuth (para conectar Gmail)
# Crear en: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Tipo: Web application | Redirect URI: https://TU_DOMINIO/api/email/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=https://registrodefinanzas.vercel.app
