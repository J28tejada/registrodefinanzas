ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vercel Postgres (se obtiene automáticamente al correr: vercel env pull .env.local)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Google OAuth (para conectar Gmail)
# Crear en: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Tipo: Web application | Redirect URI: https://TU_DOMINIO/api/email/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=https://registrodefinanzas.vercel.app

# Gemini — interpreta los mensajes, transcribe las notas de voz y lee los recibos
GOOGLE_AI_API_KEY=
# Mientras estés en el tier gratuito usá una variante "lite": la cuota de los
# modelos nuevos es por día, por proyecto y por modelo, y es más chica de lo que
# parece (ver docs/whatsapp.md).
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Agente de WhatsApp (ver docs/whatsapp.md) ───────────────────────────────
# Evolution API self-hosted, alcanzable por HTTPS desde Vercel (Cloudflare Tunnel)
EVOLUTION_API_URL=https://tu-tunel.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=finanzas
# Obligatorio: sin él el webhook queda cerrado. Cualquier cadena larga al azar.
EVOLUTION_WEBHOOK_TOKEN=
# Zona horaria con la que se resuelven "hoy" y "ayer". Vercel corre en UTC.
WHATSAPP_TIMEZONE=America/Mexico_City
# Lo genera Vercel al crear el cron; protege el recordatorio diario.
CRON_SECRET=
