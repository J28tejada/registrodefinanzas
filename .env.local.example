# ─── Supabase (base de datos, login y storage de recibos) ────────────────────
# Project Settings → API. Correr antes supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Salta RLS: la usa el webhook de WhatsApp, que no tiene sesión de navegador.
# NUNCA la pongas en una variable NEXT_PUBLIC_: viajaría al navegador.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=https://registrodefinanzas.vercel.app

# ─── Gemini ──────────────────────────────────────────────────────────────────
# Interpreta los mensajes, transcribe las notas de voz y lee los recibos.
GOOGLE_AI_API_KEY=
# Mientras estés en el tier gratuito usá una variante "lite": la cuota de los
# modelos nuevos es por día, por proyecto y por modelo (ver docs/whatsapp.md).
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Google OAuth (para conectar Gmail) ──────────────────────────────────────
# Crear en: https://console.cloud.google.com → APIs & Services → Credentials
# Tipo: Web application | Redirect URI: https://TU_DOMINIO/api/email/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Agente de WhatsApp (ver docs/whatsapp.md) ───────────────────────────────
# Evolution API self-hosted, alcanzable por HTTPS desde Vercel (Cloudflare Tunnel)
EVOLUTION_API_URL=https://tu-tunel.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=finanzas
# Obligatorio: sin él el webhook queda cerrado. Cualquier cadena larga al azar.
EVOLUTION_WEBHOOK_TOKEN=
# Lo genera Vercel al crear el cron; protege el recordatorio diario.
CRON_SECRET=
# Quién puede crear la instancia de Evolution o cerrarle la sesión. La instancia
# es UNA sola y compartida: si hay más de un usuario en la app, esto es
# obligatorio, o cualquiera puede desconectarle el WhatsApp a los demás.
ADMIN_EMAILS=vos@ejemplo.com

# La moneda, el formato regional y la zona horaria NO van acá: los elige cada
# usuario en la app, en Configuración.
