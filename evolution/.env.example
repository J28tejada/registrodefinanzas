# Copiá este archivo a `.env` (queda fuera de git) y poné tus claves.
#
#   cp .env.example .env

# La clave con la que la app le habla a Evolution. Cualquier cadena larga al
# azar; tiene que ser la MISMA que EVOLUTION_API_KEY en Vercel.
#   openssl rand -hex 32
EVOLUTION_API_KEY=

# ERROR mientras funcione; poné DEBUG solo si estás buscando un problema:
# en INFO o más abajo escupe cada mensaje que pasa.
EVOLUTION_LOG_LEVEL=ERROR
