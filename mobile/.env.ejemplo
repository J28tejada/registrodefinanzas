# Las mismas dos de la web, con otro prefijo: Expo solo expone al bundle las que
# empiezan con EXPO_PUBLIC_.
#
#   NEXT_PUBLIC_SUPABASE_URL       ->  EXPO_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  ->  EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# Copiá este archivo a mobile/.env con los valores de verdad. Sin ellos la app
# arranca igual y el login muestra un aviso diciendo cuáles faltan, que es lo
# mismo que hace la web.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
